{
	"name": "pokemon-tcg-viewer",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:preview": "VITE_CLAUDE_PREVIEW=true vite dev",
		"build": "vite build",
		"build:check": "vite build && bun run scripts/check-client-bundle.ts",
		"check:bundle": "bun run scripts/check-client-bundle.ts",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"test": "bun test",
		"typecheck": "tsc -b",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"typecheck:worker": "tsc -p worker/tsconfig.json",
		"deploy:worker": "cd worker && bunx wrangler deploy",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale",
		"postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.110.0",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-router": "^1.170.10",
		"@tanstack/react-start": "^1.168.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"deepmerge": "^4.3.1",
		"fflate": "^0.8.3",
		"idb-keyval": "^6.2.4",
		"lucide-react": "^1.17.0",
		"nitro": "^3.0.260522-beta",
		"papaparse": "^5.5.3",
		"qrcode-generator": "^2.0.4",
		"radix-ui": "^1.5.0",
		"react": "^19.2.5",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.5",
		"react-virtuoso": "^4.18.6",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"tesseract.js": "^7.0.0",
		"vite-plugin-pwa": "^1.3.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "^2.4.14",
		"@cloudflare/workers-types": "^4.20260529.1",
		"@happy-dom/global-registrator": "^20.9.0",
		"@inlang/paraglide-js": "^2.20.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/babel__core": "^7.20.5",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.12.2",
		"@types/papaparse": "^5.5.2",
		"@types/qrcode-generator": "^1.0.6",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"bun-types": "^1.3.13",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.5.0",
		"happy-dom": "^20.9.0",
		"sharp": "^0.34.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.2",
		"vite": "^8.0.10"
	}
}
