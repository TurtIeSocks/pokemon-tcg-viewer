{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023"],
		"module": "esnext",
		"types": ["node", "bun"],
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,

		/* Path alias — parity with tsconfig.app.json. The node project compiles
		   src modules dragged in by scripts (build-history.ts → price-history.ts
		   → fx.ts), which use the "@/" alias, so it must resolve it too. */
		"paths": { "@/*": ["./src/*"] },

		/* Linting */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": [
		"vite.config.ts",
		"./scripts/*.ts",
		"src/lib/version-check/vite-plugin-version.ts"
	]
}
