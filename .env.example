# Cloudflare Worker proxy base URL (no trailing slash). The Worker injects the
# pokemontcg.io API key server-side and adds an edge cache. When unset, the app
# calls api.pokemontcg.io directly at the anonymous (~1000 req/day) rate limit.
#
# Copy this file to `.env.local` (gitignored) and fill in the value.
#
# The API key is NO LONGER a client var — it lives as a Worker secret
# (`wrangler secret put POKEMONTCG_API_KEY`). See README "API proxy".
VITE_API_BASE=https://pokemon-tcg-proxy.<your-subdomain>.workers.dev
