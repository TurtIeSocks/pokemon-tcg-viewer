# Build context trimming. The image builds from source with `bun install` +
# `vite build`, so nothing pre-built or host-local should be copied in.

# Host installs / build output (rebuilt inside the image; a musl/glibc
# mismatch from a copied node_modules is a classic silent breakage).
node_modules
.output
.nitro
.tanstack
dist
dist-ssr
dev-dist

# Generated during the build by the paraglide + TanStack Start vite plugins.
# Copying stale ones in is worse than having none (see CLAUDE.md).
src/paraglide
src/routeTree.gen.ts

# Secrets + host state. Runtime config comes from the container env, never
# from a baked-in .env.
.env
.env.local
.env*.local

# VCS / CI / editor / docs — irrelevant to the runtime image.
#
# .gitignore is deliberately NOT excluded. Tailwind v4 automatically detects
# which files to scan for class names and prunes that walk with .gitignore.
# Without it in the context, the SSR pass scans the client pass's own build
# output, generates a different set of utilities, and hashes app.css
# differently — so the SSR HTML links a stylesheet that was never emitted, it
# 404s, and every page renders unstyled white until the client bundle boots.
# scripts/check-ssr-assets.ts fails the build if that ever recurs.
.git
.github
.claude
.vscode
.idea
.DS_Store
docs
refactor-workspace
supabase
worker
deploy
*.md

# Local corpus artifacts (served from R2 via the Cloudflare Worker, not the app).
corpus
corpus*.json.gz
corpus-detail.meta.json
corpus-gap.json
scripts/data/.cache

# Test-only noise
*.log
.playwright-mcp
